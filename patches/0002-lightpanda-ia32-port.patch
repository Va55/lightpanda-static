diff --git a/src/atomic_u64.zig b/src/atomic_u64.zig
new file mode 100644
index 0000000..61c4c63
--- /dev/null
+++ b/src/atomic_u64.zig
@@ -0,0 +1,42 @@
+// AtomicU64Slot - a u64-compatible atomic slot that compiles on 32-bit targets
+// (usize == u32), where Zig's std.atomic.Value(u64) does not compile.
+//
+// Implemented internally as std.atomic.Value(u32): stores truncate to 32 bits,
+// loads zero-extend back to u64. The consumers are watchdog/log/stall fields
+// holding monotonic ms timestamps and a page-id sequencer. The 32-bit wrap
+// (~49.7 days, ~4.29e9 ids) is benign: consumers compare recent deltas
+// (unsigned, wrapped subtraction is correct) or only test "is non-zero".
+//
+// Call-site shape matches the std.atomic.Value calls they replace:
+//   load()            = load (non-const, like the original atomic .load)
+//   store(v)          = store
+//   swap(v)           = swap (returns old value)
+//   cmpxchg(old,new)  = cmpxchgStrong (null on success, else current value)
+//   fetchAdd(x)       = fetchAdd (returns old value)
+const std = @import("std");
+
+pub const Value = struct {
+    inner: std.atomic.Value(u32) = .init(0),
+
+    pub fn load(self: *const Value) u64 {
+        return self.inner.load(.monotonic);
+    }
+
+    pub fn store(self: *Value, v: u64) void {
+        self.inner.store(@truncate(v), .monotonic);
+    }
+
+    pub fn swap(self: *Value, v: u64) u64 {
+        return @atomicRmw(u32, &self.inner.raw, .Xchg, @truncate(v), .monotonic);
+    }
+
+    pub fn fetchAdd(self: *Value, x: u64) u64 {
+        return @atomicRmw(u32, &self.inner.raw, .Add, @truncate(x), .monotonic);
+    }
+
+    pub fn cmpxchg(self: *Value, old: u64, new: u64) ?u64 {
+        const res = @cmpxchgStrong(u32, &self.inner.raw, @truncate(old), @truncate(new), .monotonic, .monotonic);
+        if (res) |cur| return cur;
+        return null;
+    }
+};
